  "declaredAt": "2026-07-30",
  "requiredMarkers": [
    "harness/lib/v4",
    "harness/contracts/v4",
    "harness/auditor",
    "harness/tests"
  ],
  "readinessFiles": [
    "harness/cli.mjs",
    "harness/version.json",
    "harness/contracts/v4/invariant-catalog.json",
    "harness/auditor/cli.mjs",
    ".codex/hooks/pre_tool_use_policy.py",
    ".codex/hooks/post_tool_use_guard.py",
    ".codex/hooks/stop_guard.py"
  ],
  "validationProfile": {
    "schemaVersion": 2,
    "policyDefaults": {
      "resources": {
        "timeoutMs": 900000,
        "maxOutputBytes": 10485760,
        "maxMemoryMb": 2048,
        "maxProcesses": 16
      },
      "network": {
        "mode": "deny",
        "invariantPolicyId": null,
        "allowedDestinations": []
      },
      "environment": {
        "allow": [],
        "values": {}
      },
      "writablePaths": [
        ".harness/state/resource-locks"
      ]
    },
    "commands": {
      "lint": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "syntax"]}
      ],
      "typecheck": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "syntax"]}
      ],
      "testUnit": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "unit"]}
      ],
      "testIntegration": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "integration"]}
      ],
      "testContract": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "contract"]}
      ],
      "testE2E": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "e2e"]}
      ],
      "build": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "build"]}
      ],
      "generateClient": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "syntax"]}
      ],
      "fullCI": [
        {"cwd": "repo", "command": "node", "args": ["harness/tests/run-all.mjs", "--profile", "full-ci"]}
      ]
    }
  }
}
