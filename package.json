{
  "name": "scopelatch-agent-engineering-harness",
  "version": "4.0.0",
  "description": "ScopeLatch is a repository-aware engineering control plane for AI coding agents.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Zihang Zhong",
  "homepage": "https://github.com/zzh3110296407-cmd/ScopeLatch-Agent-Engineering-Harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzh3110296407-cmd/ScopeLatch-Agent-Engineering-Harness.git"
  },
  "bugs": {
    "url": "https://github.com/zzh3110296407-cmd/ScopeLatch-Agent-Engineering-Harness/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node harness/tests/run-all.mjs",
    "test:syntax": "node harness/tests/run-all.mjs --profile syntax",
    "test:unit": "node harness/tests/run-all.mjs --profile unit",
    "test:contract": "node harness/tests/run-all.mjs --profile contract",
    "test:integration": "node harness/tests/run-all.mjs --profile integration",
    "test:e2e": "node harness/tests/run-all.mjs --profile e2e",
    "build": "node harness/tests/run-all.mjs --profile build",
    "ci": "node harness/tests/run-all.mjs --profile full-ci",
    "scopelatch": "node harness/cli.mjs",
    "harness": "node harness/cli.mjs",
    "harness:shadow": "node harness/qualification/run-shadow-pair.mjs",
    "harness:qualify": "node harness/qualification/qualify-shadow-window.mjs",
    "harness:formal": "node harness/qualification/run-formal-ci.mjs",
    "status": "node harness/cli.mjs status",
    "index": "node harness/cli.mjs index",
    "evidence:verify": "node scripts/verify-effect-comparison.mjs",
    "security": "node harness/cli.mjs security --profile public-release",
    "sandbox:verify": "node harness/cli.mjs sandbox --verify --build",
    "install:target": "node scripts/install.mjs"
  },
  "keywords": [
    "scopelatch",
    "ai-agent",
    "codex",
    "harness",
    "guardrails",
    "code-review",
    "validation"
  ]
}
